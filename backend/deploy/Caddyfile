# TLS-Terminierung fuer das Backend (AGENT.md 3.2): nur TLS 1.3, HSTS, kein Logging von Query-Strings.
# Ersetze api.example.de durch deine Domain (DNS muss auf den Server mit deutscher IP zeigen).
api.example.de {
	tls {
		protocols tls1.3
		# Schluessel bei Erneuerung wiederverwenden, damit der SPKI-Pin der App gueltig bleibt.
		# (key_type legt nur den Algorithmus fest, nicht den Schluessel.)
		key_type p256
		reuse_private_keys
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/transitplanner.log
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers>Authorization delete
				request>remote_ip delete
				request>client_ip delete
				resp_headers>Ratelimit-Policy delete
				resp_headers>Ratelimit delete
			}
		}
	}
}
