{
  "name": "transitplanner-backend",
  "version": "0.1.0",
  "description": "Routing-Proxy fuer MOTIS (Transitous): nur Koordinaten, Haltestellen und Zeiten, keine Nutzerdaten",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js"
  },
  "license": "MIT",
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@motis-project/motis-client": "2.11.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
