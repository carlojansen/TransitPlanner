# Kopieren nach .env und ausfuellen:  cp .env.example .env
# Datei schuetzen:  chmod 600 .env

# Pflicht (Transitous-Nutzungsregel): "Name/Version (Kontakt)", Kontakt = E-Mail oder URL
USER_AGENT="TransitPlanner/0.1.0 (https://github.com/carlojansen/TransitPlanner)"
# Pflicht: >= 32 Zeichen. Erzeugen mit:  openssl rand -base64 36
API_TOKEN=
# Optional: weitere gueltige Tokens, kommagetrennt (Token-Rotation ohne Ausfall), je >= 32 Zeichen
# API_TOKENS=

# MOTIS-Instanz. Standard Transitous; spaeter eigene Instanz moeglich (nur https)
MOTIS_BASE_URL=https://api.transitous.org

HOST=127.0.0.1
PORT=3000
TRUST_PROXY=1
RATE_LIMIT_PER_MINUTE=60
# Zusaetzliche Limits pro Client-IP fuer teure Pfade
RATE_LIMIT_LOCATIONS_PER_MINUTE=20
RATE_LIMIT_ROUTES_PER_MINUTE=8
RATE_LIMIT_REFRESH_PER_MINUTE=12
# Ruecksicht auf Transitous: 1 Anfrage je 1000 ms = 60/Minute; Routensuchen max. 30/Minute
UPSTREAM_LIMIT=1
UPSTREAM_INTERVAL_MS=1000
UPSTREAM_TIMEOUT_MS=12000
# Max. wartende Upstream-Anfragen; darueber sofort 502 mit Retry-After statt Stau
UPSTREAM_MAX_QUEUE=20
# Routing: max. Fussweg zum ersten/letzten Halt in Sekunden (300-3600, MOTIS-Standard 900) und
# zusaetzliche Umsteigezeit je Umstieg in Minuten (0-10, MOTIS-Standard 0)
# MAX_PRE_TRANSIT_SECONDS=900
# MAX_POST_TRANSIT_SECONDS=900
# ADDITIONAL_TRANSFER_MINUTES=0
LOG_LEVEL=info
